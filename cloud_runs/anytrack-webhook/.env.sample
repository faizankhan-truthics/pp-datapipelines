# Copy to .env for local runs (never commit the real .env file).
# In Cloud Run, set these as service env vars / Secret Manager references instead.

# sandbox | production
ENVIRONMENT=sandbox

# GCS bucket this service writes landing events to.
# Use a separate bucket per environment -- never share sandbox and prod buckets.
GCS_BUCKET=your-landing-bucket-sandbox

# Required for local runs under `gcloud auth application-default login` --
# user ADC doesn't always carry a project ID (unlike Cloud Run's metadata
# server, where this can be left unset). Not needed when deployed.
GOOGLE_CLOUD_PROJECT=your-sandbox-project-id

# Label for which product group this deployment serves -- logging only,
# doesn't gate behavior. Pick whatever matches the group you're testing.
PRODUCT_GROUP=core

# {"<product>": "<webhook secret>"} for every product in this group, as one
# JSON string. In Cloud Run this comes from a Secret Manager reference (see
# README's Deploy section) -- never set as a plaintext env var there. For
# local runs, it's fine to put real sandbox secrets directly in your local
# .env (not committed).
ANYTRACK_PRODUCTS_CONFIG={"iqcenter":"replace-with-sandbox-secret","infochecker":"replace-with-sandbox-secret"}
